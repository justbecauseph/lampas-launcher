{
  "name": "lampas-launcher",
  "version": "1.7.0",
  "description": "Deterministic, Standalone Modpack Launcher for Lampas SMP",
  "private": true,
  "main": "dist/main.js",
  "license": "Apache-2.0",
  "author": "Lampas Tech Team",
  "desktopName": "Lampas Launcher",
  "linux": {
    "syncDesktopName": true
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "benchmark": "bun test/benchmark/benchmark-harness.ts",
    "smoke": "bun test/smoke/electron-smoke.ts",
    "dev": "concurrently \"tsc -w\" \"vite\" \"electron .\"",
    "build": "tsc && vite build",
    "format:check": "bunx prettier -c .",
    "format": "bunx prettier -w .",
    "package:dir": "tsc && vite build && electron-builder --dir --publish never",
    "package:win": "tsc && vite build && electron-builder --win --publish never",
    "package:msix": "tsc && vite build && electron-builder --win appx --publish never",
    "package:appx": "tsc && vite build && electron-builder --win appx --publish never",
    "package:test": "pwsh scripts/package-and-test.ps1",
    "package:linux": "tsc && vite build && electron-builder --linux --publish never",
    "package:all": "tsc && vite build && electron-builder -mwl --publish never",
    "start": "electron .",
    "security:artifacts": "bun scripts/security-artifacts.ts",
    "security:fuses": "node scripts/verify-fuses.cjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.7",
    "electron": "45.3.0",
    "electron-builder": "^26.18.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": "5.1.0",
      "minimatch": "11.0.7"
    },
    "@electron/universal": {
      "minimatch": "11.0.7"
    }
  },
  "trustedDependencies": [
    "electron"
  ],
  "build": {
    "appId": "town.lampas.launcher",
    "productName": "Lampas Launcher",
    "publish": null,
    "forceCodeSigning": false,
    "beforePack": "scripts/pack-security.cjs",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    },
    "directories": {
      "output": "release"
    },
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "ui/assets/fonts/LICENSE.txt",
        "to": "licenses/fonts-LICENSE.txt"
      }
    ],
    "win": {
      "icon": "assets/lampas.png",
      "artifactName": "LampasLauncher-${version}-Windows.${ext}",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "LampasLauncher-Setup-${version}.${ext}",
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "appx": {
      "applicationId": "LampasLauncher",
      "identityName": "59450PUPProgGuild.LampasLauncher",
      "publisher": "CN=4930FAFD-2456-4E8B-BED5-C5CC9A2E0575",
      "publisherDisplayName": "PUPProgGuild",
      "displayName": "Lampas Launcher",
      "backgroundColor": "#1e1e1e",
      "minVersion": "10.0.17763.0",
      "languages": [
        "en-US"
      ],
      "capabilities": [
        "runFullTrust",
        "internetClient"
      ]
    },
    "linux": {
      "icon": "assets/lampas.png",
      "artifactName": "LampasLauncher-${version}-Linux.${ext}",
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Game"
    }
  }
}
