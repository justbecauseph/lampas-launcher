{
  "name": "lampas-launcher",
  "version": "1.2.0",
  "description": "Deterministic, Standalone Modpack Launcher for Lampas SMP",
  "private": true,
  "main": "dist/main.js",
  "license": "Apache-2.0",
  "author": "Lampas Tech Team",
  "desktopName": "Lampas Launcher",
  "linux": {
    "syncDesktopName": true
  },
  "scripts": {
    "dev": "concurrently \"tsc -w\" \"electron .\"",
    "build": "tsc",
    "package:dir": "tsc && electron-builder --dir --publish never",
    "package:win": "tsc && electron-builder --win --publish never",
    "package:linux": "tsc && electron-builder --linux --publish never",
    "package:all": "tsc && electron-builder -mwl --publish never",
    "start": "electron ."
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.3.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.9.0",
    "concurrently": "^9.1.2",
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.2"
  },
  "build": {
    "appId": "town.lampas.launcher",
    "productName": "Lampas Launcher",
    "publish": null,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "ui/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/lampas.png",
      "artifactName": "LampasLauncher-${version}-Windows.${ext}",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "LampasLauncher-Setup-${version}.${ext}",
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "icon": "assets/lampas.png",
      "artifactName": "LampasLauncher-${version}-Linux.${ext}",
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Game"
    }
  }
}
